# PostgreSQL Database Settings
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=psqltest123
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:psqltest123@127.0.0.1:5432/postgres

# API Service Port Mappings
USER_API_PORT=8081
TASK_API_PORT=8082

# Authentication (JWT)
JWT_SECRET=dev-secret-key-change-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Database Schemas
USER_API_DB_SCHEMA=users_api
TASK_API_DB_SCHEMA=tasks_api

# Platform Maintenance / Cleanup
BATCH_SIZE=1000
LOG_LEVEL=INFO